App(
    appid="meshtastic",
    name="Meshtastic",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="meshtastic_app",
    stack_size=4 * 1024,
    requires=["gui"],
    fap_libs=["nanopb"],
    cflags=["-Iapplications/external/meshtastic/proto"],
    fap_category="Bluetooth",
    fap_icon="icon.png",
    fap_author="@KaraZajac",
    fap_version="0.1",
    fap_description="Meshtastic mesh network client — connect to a Meshtastic node over BLE to send and receive messages",
)
